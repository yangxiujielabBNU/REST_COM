print("=" * 70)
print("补充分析1: Cohen's d 效应量")
print("=" * 70)

# 效应量解释标准 (Cohen, 1988):
# d = 0.2  -> 小效应 (small)
# d = 0.5  -> 中效应 (medium) 0.8  
# d =  -> 大效应 (large)

def cohens_d(group1, group2):
    """计算两组之间的Cohen's d效应量"""
    n1, n2 = len(group1), len(group2)
    var1, var2 = np.var(group1, ddof=1), np.var(group2, ddof=1)
    pooled_std = np.sqrt(((n1 - 1) * var1 + (n2 - 1) * var2) / (n1 + n2 - 2))
    return (np.mean(group1) - np.mean(group2)) / pooled_std

# 读取之前保存的数据
OUTPUT_PATH = Path('reports/comparison/lme_frequency')
df = pd.read_csv(OUTPUT_PATH / 'trial_level_data.csv')

# 按被试计算平均功率（避免重复测量导致的标准误低估）
subject_means = df.groupby(['subject_id', 'group', 'band'])['power'].mean().reset_index()
subject_means['log_power'] = np.log10(subject_means['power'] + 1e-20)

# 计算各组的效应量
effect_size_results = []

for band in ['Delta', 'Theta', 'Alpha', 'Beta', 'Gamma']:
    band_data = subject_means[subject_means['band'] == band]
    
    # ADHD vs TD
    adhd_vals = band_data[band_data['group'] == 'adhd']['log_power'].values
    td_vals = band_data[band_data['group'] == 'td']['log_power'].values
    d_adhd_td = cohens_d(adhd_vals, td_vals)
    
    # COM vs TD  
    com_vals = band_data[band_data['group'] == 'com']['log_power'].values
    d_com_td = cohens_d(com_vals, td_vals)
    
    # ADHD vs COM
    d_adhd_com = cohens_d(adhd_vals, com_vals)
    
    effect_size_results.append({
        'band': band,
        'd_ADHD_vs_TD': d_adhd_td,
        'd_COM_vs_TD': d_com_td,
        'd_ADHD_vs_COM': d_adhd_com
    })

effect_df = pd.DataFrame(effect_size_results)

print("\nCohen's d 效应量表:")
print("-" * 70)
print(effect_df.to_string(index=False))

print("\n效应量解释标准: |d| < 0.2 = 微小, 0.2-0.5 = 小, 0.5-0.8 = 中, > 0.8 = 大")
print("-" * 70)

